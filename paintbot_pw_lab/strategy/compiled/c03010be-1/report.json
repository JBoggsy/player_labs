  "guesses": [
    {
      "component": "K.squad_target",
      "decision": "Wrapped the whole stall-memory step in `IF progress_period > 0`, so a tuned value of 0 skips Step 1 instead of dividing by zero.",
      "id": "G-K.squad_target-1",
      "severity": "low",
      "spec_quote": "When `worldTick MOD progress_period = 0`",
      "state": "open",
      "why": "AGENTS.md rule 5 requires guarding every MOD; progress_period is a tunable param, not a literal."
    },
    {
      "component": "C.take_heart",
      "decision": "Read controlX/controlY(objective) without checking objective >= 0. If the activation runs with objective = -1, the host returns -1 (invalid index), so there is no runtime error. The goal is then (-1, -1), which the engine clamps.",
      "id": "G-C.take_heart-1",
      "severity": "low",
      "spec_quote": "`goal_x = controlX(objective)`",
      "state": "open",
      "why": "The spec has no objective >= 0 guard here, unlike the default_goal/resupply/fall_back steps. The selector presumably runs this only when S.has_target_heart is on, and controlX(-1) is safe."
    },
    {
      "component": "C.cover_heart",
      "decision": "Same as C.take_heart: no objective >= 0 guard, relying on controlX(-1) = -1 being safe.",
      "id": "G-C.cover_heart-1",
      "severity": "low",
      "spec_quote": "`hx = controlX(objective)`",
      "state": "open",
      "why": "Literal reading of the spec. The host returns -1 for invalid indices instead of raising an error."
    },
    {
      "component": "C.default_goal",
      "decision": "Used the legacy host fields carrying, ownHeartStolen, heartX and heartY exactly as written. Under rules 47 carrying and ownHeartStolen are always 0 and heartX/heartY read the enemy home, so in practice the goal is the thief (never set, see gaps) or the enemy home.",
      "id": "G-C.default_goal-1",
      "severity": "medium",
      "spec_quote": "else `(heartX, heartY)`",
      "state": "open",
      "why": "The spec names these fields explicitly and matches base.bas; I did not substitute control* fields."
    },
    {
      "component": "COM.grenade_out",
      "decision": "Read sk_motor__threw as left by the most recent SK.motor run before __send. If send runs before motor on a tick, the callout comes one tick late.",
      "id": "G-COM.grenade_out-1",
      "severity": "low",
      "spec_quote": "when threw of `SK.motor` is 1",
      "state": "possibly resolved",
      "why": "Call order is generated and not visible to the unit."
    },
    {
      "component": "K.pickups",
      "decision": "Kept the literal HP thresholds (medkit wanted below 3 HP, armor only at exactly 3 HP, medkit cost quartered at 1 HP) even though rules 49 HP runs 0-10.",
      "id": "G-K.pickups-1",
      "severity": "medium",
      "spec_quote": "(kind = 2 AND selfHp < 3)",
      "state": "open",
      "why": "The numbers are written into the Spec, not Params; changing them would be inventing behavior. Under rules 49 armor is rarely wanted and medkits only when nearly dead."
    },
    {
      "component": "K.pickups",
      "decision": "Step 0 tests mem_tick(j) = worldTick literally, so a take is detected only when the station was in view on the immediately previous tick (mem_tick = previous tick + 1). The pickupVisible, prev_ and host state values are read once per tick and reused for Step 0c.",
      "id": "G-K.pickups-2",
      "severity": "low",
      "spec_quote": "`mem_tick(j) = worldTick` (previously visible and ready)",
      "state": "open",
      "why": "Literal reading; the runtime runs every living tick, so worldTick advances by 1 between updates."
    },
    {
      "component": "K.contacts",
      "decision": "Own evidence (and so xe_label) is evaluated only for teammate-parity bodies that reached Step 0c, that is not matched by a live friend record and not enemy parity.",
      "id": "G-K.contacts-1",
      "severity": "low",
      "spec_quote": "whose own evidence holds and where",
      "state": "open",
      "why": "Own evidence is defined inside Step 0c, and a body matched in Step 0a skips to the next i."
    },
    {
      "component": "K.contacts",
      "decision": "Kept the literal 3 in the cost even though rules 49 HP is 0-10; the term still ranks wounded bodies first, offset by a constant.",
      "id": "G-K.contacts-2",
      "severity": "low",
      "spec_quote": "`cost = d2 - (3 - playerHp(i)) * hp_weight`",
      "state": "open",
      "why": "The value is in the Spec, not a Param."
    },
    {
      "component": "COM.disguise_alert",
      "decision": "When a report fills witness 1 (expired slot) and the live witness 2 has the same speaker, witness 2 is expired (xa_t2 = 0).",
      "id": "G-COM.disguise_alert-1",
      "severity": "medium",
      "spec_quote": "one sender never fills both witnesses",
      "state": "open",
      "why": "The explicit witness-1 rule does not check witness 2, so without this one sender could hold both slots and block a real second witness. Expiring the duplicate keeps the stated invariant; K.contacts also requires xa_s1 <> xa_s2."
    },
    {
      "component": "COM.disguise_alert",
      "decision": "The reset is done in __recv for label L, before this message is applied, when both xa_t1(L) and xa_t2(L) are <= worldTick.",
      "id": "G-COM.disguise_alert-2",
      "severity": "low",
      "spec_quote": "Set `xa_amb(L) = 0` again when both witnesses",
      "state": "open",
      "why": "COM units have no per-tick SUB, and send/recv may not run on a given tick. A stale amb is harmless while both witnesses are expired, because K.contacts also requires live witnesses."
    },
    {
      "component": "COM.disguise_alert",
      "decision": "A message whose cm__fa is outside 0..15 is ignored. In __send, the strong label is used only when 0 <= xe_label < 16.",
      "id": "G-COM.disguise_alert-3",
      "severity": "low",
      "spec_quote": "In `__recv`: set `L = cm__fa`, `amb = 0`",
      "state": "open",
      "why": "This keeps every array index in range (AGENTS.md rule 5); the wire field width is not visible to the unit."
    },
    {
      "component": "COM.disguise_friend",
      "decision": "Within means squared distance <= d_range_sq. In __recv, a cm__fa outside 0..15 is ignored.",
      "id": "G-COM.disguise_friend-1",
      "severity": "low",
      "spec_quote": "visible within `d_range_sq`",
      "state": "open",
      "why": "Inclusive bound, plus the index guard required by rule 5."
    },
    {
      "component": "COM.enemy_sighting",
      "decision": "Teammate seats are s <> selfId with s MOD 2 = selfTeam. The cost of a body is its squared distance to the nearest such recently heard teammate, or to us when there is none.",
      "id": "G-COM.enemy_sighting-1",
      "severity": "low",
      "spec_quote": "Choose the one nearest to any teammate seat s with",
      "state": "open",
      "why": "cm__heard_* is kept per claimed sender seat, which may include enemy-parity labels; the spec says teammate."
    },
    {
      "component": "COM.glory_seen",
      "decision": "Position matching for gl_* (in __recv) and hs_* (after a send) considers only slots in use (gl_until > 0, hs_t > 0), taking the lowest matching slot. Otherwise it takes the slot with the smallest gl_until or hs_t, lowest index on a tie.",
      "id": "G-COM.glory_seen-1",
      "severity": "low",
      "spec_quote": "Use the slot j that is within h_match of `(px, py)`",
      "state": "open",
      "why": "Without this, an empty slot at (0, 0) would match a heart near the origin."
    },
    {
      "component": "COM.grenade_warning",
      "decision": "release_in is sent unclamped, exactly as SK.motor reports it.",
      "id": "G-COM.grenade_warning-1",
      "severity": "low",
      "spec_quote": "call `cm__send(2, release_in, 0, cell, quiet)`",
      "state": "open",
      "why": "The spec gives no clamp; the runtime owns encoding."
    }
  ],
